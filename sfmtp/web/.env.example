# Laravel API base URL, reached server-side by the Next.js BFF only.
SFMTP_API_URL=http://localhost:8000
# Map tiles (XYZ). Defaults to OpenStreetMap; use your own provider in production.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
